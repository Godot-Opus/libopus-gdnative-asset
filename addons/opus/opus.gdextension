[configuration]

entry_symbol = "opus_library_init"
compatibility_minimum = "4.1"

[libraries]

linux.debug.x86_64 = "res://addons/opus/bin/linux/libgodotopus.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/opus/bin/linux/libgodotopus.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/opus/bin/windows/libgodotopus.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/opus/bin/windows/libgodotopus.windows.template_release.x86_64.dll"
macos.debug = "res://addons/opus/bin/macos/libgodotopus.macos.template_debug.framework"
macos.release = "res://addons/opus/bin/macos/libgodotopus.macos.template_release.framework"
android.debug.arm64 = "res://addons/opus/bin/android/libgodotopus.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/opus/bin/android/libgodotopus.android.template_release.arm64.so"

[icons]

OpusEncoderNode = "res://addons/opus/ic_encoder.png"
OpusDecoderNode = "res://addons/opus/ic_decoder.png"
